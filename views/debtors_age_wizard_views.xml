<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcl_debtors_age_wizard_form" model="ir.ui.view">
        <field name="name">dcl.debtors.age.wizard.form</field>
        <field name="model">dcl.debtors.age.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Debtors Age Analysis">
                <sheet>
                    <div class="oe_title">
                        <h1>Debtors Age Analysis</h1>
                        <p class="text-muted">Upload the consolidated monthly Debtors List and generate the property-by-property ageing workbook.</p>
                    </div>
                    <group>
                        <group>
                            <field name="source_file" filename="source_filename"/>
                            <field name="source_filename" invisible="1"/>
                            <field name="reporting_date"/>
                            <field name="source_sheet" placeholder="Auto-detect"/>
                        </group>
                        <group invisible="not result_file">
                            <field name="currency_id"/>
                            <field name="property_count"/>
                            <field name="debtor_count"/>
                            <field name="exception_count"/>
                            <field name="total_receivables"/>
                        </group>
                    </group>
                    <group invisible="not result_file">
                        <field name="status_message" nolabel="1" readonly="1"/>
                        <field name="result_file" filename="result_filename" readonly="1"/>
                        <field name="result_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Age Analysis" type="object" class="btn-primary"/>
                    <button name="action_download" string="Download Excel" type="object" class="btn-secondary" invisible="not result_file"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dcl_debtors_age_wizard" model="ir.actions.act_window">
        <field name="name">Debtors Age Analysis</field>
        <field name="res_model">dcl.debtors.age.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
